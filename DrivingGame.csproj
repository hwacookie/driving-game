<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DrivingGame</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- The C# sim port (docs/C_SHARP_PORT_SPEC.md) lives in sibling projects;
       keep it out of the Godot assembly's compile glob. -->
  <ItemGroup>
    <Compile Remove="DrivingGame.Sim/**" />
    <Compile Remove="DrivingGame.Server/**" />
    <Compile Remove="DrivingGame.Sim.Tests/**" />
  </ItemGroup>

</Project>
